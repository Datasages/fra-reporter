# FRA Report Generator - Terraform Variables Example
# Copy to terraform.tfvars and update with your values

# AWS Configuration
aws_region  = "us-east-1"
environment = "production"

# Application Configuration
project_name = "fra-report-generator"
docker_image = "petekofod/fra-report-generator:v1.0.0"

# Compute Resources
task_cpu    = 2048  # 2 vCPUs
task_memory = 4096  # 4 GB RAM
max_vcpus   = 16    # Maximum concurrent vCPUs

# Application Settings
java_opts = "-Xmx3g -Xms2g -XX:+UseG1GC -XX:MaxGCPauseMillis=200"
log_level = "INFO"

# Job Configuration
retry_attempts        = 2
job_timeout_seconds   = 86400  # 24 hours
log_retention_days    = 30

# MongoDB Configuration (replace with your actual connection strings)
reports_mongo_url  = "mongodb://reportMetaDataWriter:PASSWORD@HOST:27017/"
messages_mongo_url = "mongodb://reportReader:PASSWORD@HOST:27017/?authSource=reports"

reports_mongo_database  = "reportMetaData"
messages_mongo_database = "reports"
reports_mongo_collection  = "reports"
messages_mongo_collection = "messages"

# S3 Configuration
s3_bucket_name = "rwn.amtk.reports"

# Scheduling
enable_scheduling   = true
schedule_expression = "cron(0 6 2 * ? *)"  # 6 AM UTC on 2nd day of each month
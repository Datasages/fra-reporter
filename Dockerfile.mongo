# DocumentDB to MongoDB Migration Container
# Copies documents from DocumentDB to MongoDB for previous month and cleans up old records

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create app user for security
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

# Copy requirements first for better layer caching
COPY <<EOF requirements.txt
pymongo>=4.5.0
dnspython>=2.4.0
EOF

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy migration script
COPY scripts/mongo_migration.py /app/migration.py

# Create startup script
RUN cat > /app/start.sh << 'EOF'
#!/bin/bash
set -e

echo "=== DocumentDB to MongoDB Migration ==="
echo "Starting at: $(date -u)"
echo "Environment:"
echo "  - Source DB: ${SOURCE_DATABASE:-reports}"
echo "  - Target DB: ${TARGET_DATABASE:-reports}"
echo "  - Collection: ${COLLECTION_NAME:-messages}"
echo "  - Batch Size: ${BATCH_SIZE:-1000}"
echo "  - Python Version: $(python --version)"

# Validate required environment variables
if [ -z "$DOCUMENTDB_URI" ]; then
    echo "ERROR: DOCUMENTDB_URI environment variable is required"
    exit 1
fi

if [ -z "$MONGODB_URI" ]; then
    echo "ERROR: MONGODB_URI environment variable is required"
    exit 1
fi

# Log connection info (without credentials)
echo "Source URI: $(echo $DOCUMENTDB_URI | sed 's/:\/\/.*@/:\/\/***:***@/')"
echo "Target URI: $(echo $MONGODB_URI | sed 's/:\/\/.*@/:\/\/***:***@/')"

# Run migration
echo ""
echo "Starting migration process..."
python /app/migration.py \
    --source-uri "$DOCUMENTDB_URI" \
    --target-uri "$MONGODB_URI" \
    --source-db "${SOURCE_DATABASE:-reports}" \
    --target-db "${TARGET_DATABASE:-reports}" \
    --collection "${COLLECTION_NAME:-messages}" \
    --batch-size "${BATCH_SIZE:-1000}" \
    "$@"

exit_code=$?
echo ""
echo "Migration completed at: $(date -u)"
echo "Exit code: $exit_code"

if [ $exit_code -eq 0 ]; then
    echo "✅ Migration successful"
else
    echo "❌ Migration failed"
fi

exit $exit_code
EOF

# Make startup script executable
RUN chmod +x /app/start.sh

# Create health check script
RUN cat > /app/health.sh << 'EOF'
#!/bin/bash
# Simple health check - verify Python and dependencies
python -c "import pymongo; print('Health check: OK')" 2>/dev/null || exit 1
EOF

RUN chmod +x /app/health.sh

# Set ownership
RUN chown -R appuser:appgroup /app

# Switch to app user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD /app/health.sh

# Set default environment variables
ENV PYTHON_UNBUFFERED=1
ENV PYTHONIOENCODING=utf-8
ENV TZ=UTC
ENV SOURCE_DATABASE=reports
ENV TARGET_DATABASE=reports
ENV COLLECTION_NAME=messages
ENV BATCH_SIZE=1000

# Entry point
ENTRYPOINT ["/app/start.sh"]

# Default command (can be overridden)
CMD []

# Labels
LABEL maintainer="Railwaynet Team" \
      description="DocumentDB to MongoDB Migration Tool" \
      version="1.0.0" \
      purpose="Copy monthly documents and cleanup old records"